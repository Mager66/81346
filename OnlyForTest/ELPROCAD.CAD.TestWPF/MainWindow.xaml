<Window x:Class="ELPROCAD.CAD.TestWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ELPROCAD.CAD.TestWPF"
        mc:Ignorable="d"
        d:DataContext="{x:Static local:MainWindowDesignModel.Instance}"
        Title="MainWindow" Height="450" Width="800">

    <Border Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0"
                        DataContext="{Binding EditVM.TheMainClass}">
                <TextBox x:Name="AbbrevationInput"
                     Text="{Binding Abbrevation,
                            UpdateSourceTrigger=PropertyChanged,
                            ValidatesOnNotifyDataErrors=True}"/>

                <ItemsControl ItemsSource="{Binding ElementName=AbbrevationInput,
                        Path=(Validation.Errors)}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent}"
                                   Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <GroupBox Grid.Row="1" Header="Testar Main Class">
                <TextBlock Text="{Binding EditVM.TheMainClass.Abbrevation,
                    UpdateSourceTrigger=PropertyChanged,
                    ValidatesOnNotifyDataErrors=True}"/>
            </GroupBox>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding MainClasses}"
                      AutoGenerateColumns="False"
                      RowValidationErrorTemplate="{x:Null}">
                
                <DataGrid.ItemBindingGroup>
                    <BindingGroup ValidatesOnNotifyDataError="False"/>
                </DataGrid.ItemBindingGroup>

                <DataGrid.Resources>
                    <Style x:Key="ValidationToolTipStyle" TargetType="{x:Type FrameworkElement}">
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip>
                                            <ItemsControl ItemsSource="{Binding PlacementTarget.(Validation.Errors),
                                                                        RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ErrorContent}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="CellDisplayValidationStyle" 
                           TargetType="{x:Type TextBlock}"
                           BasedOn="{StaticResource ValidationToolTipStyle}"/>

                    <Style x:Key="CellEditValidationStyle"
                           TargetType="{x:Type TextBox}"
                           BasedOn="{StaticResource ValidationToolTipStyle}"/>

                </DataGrid.Resources>

                <DataGrid.RowHeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="!"
                                   Foreground="Red"
                                   FontWeight="Bold"
                                   ToolTip="Raden innehåller valideringsfel">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                        Binding="{Binding DataContext.TheMainClass.HasErrors,
                                                    RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                                    Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </DataGrid.RowHeaderTemplate>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Klass"
                                        ElementStyle="{StaticResource CellDisplayValidationStyle}"
                                        EditingElementStyle="{StaticResource CellEditValidationStyle}"
                                        Binding="{Binding TheMainClass.Abbrevation,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    ValidatesOnNotifyDataErrors=True}"/>

                    <DataGridTextColumn Header="Tooltip"
                                        ElementStyle="{StaticResource CellDisplayValidationStyle}"
                                        EditingElementStyle="{StaticResource CellEditValidationStyle}"
                                        Binding="{Binding TheMainClass.Tooltip,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    ValidatesOnNotifyDataErrors=True}"/>

                    <DataGridTextColumn Header="Rolig bild"
                                        Binding="{Binding TheMainClass.Image}"/>

                    <DataGridCheckBoxColumn Header="Status"
                                            Binding="{Binding IsNew}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="3"
                    Content="Spara"
                    Command="{Binding SaveCmd}"/>
        </Grid>
    </Border>
</Window>
