<Window x:Class="ELPROCAD.ProjectExplorer.UIs.ProjectExplorerWindow.View.ProjectExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:design="clr-namespace:ELPROCAD.ProjectExplorer.UIs.ProjectExplorerWindow.ViewModel.Design"
        mc:Ignorable="d"
        Title="ELPROCAD Project Explorer"
        Width="1000"
        Height="650"
        MinWidth="650"
        MinHeight="400"
        d:DataContext="{x:Static design:ProjectExplorerDesignModel.Instance}">

    <Border Padding="5">
        <Grid>
            <Grid.Resources>
                <CollectionViewSource x:Key="RowsView"
                                      Source="{Binding Rows}">
                    <CollectionViewSource.SortDescriptions>
                        <componentModel:SortDescription PropertyName="Title"
                                                        Direction="Ascending"/>
                    </CollectionViewSource.SortDescriptions>
                </CollectionViewSource>

                <CollectionViewSource x:Key="SymbolsView" Source="{Binding Symbols}">
                    <CollectionViewSource.SortDescriptions>
                        <componentModel:SortDescription
                            PropertyName="Caption"
                            Direction="Ascending"/>
                    </CollectionViewSource.SortDescriptions>
                </CollectionViewSource>

                <CollectionViewSource x:Key="TerminalsView" Source="{Binding TerminalDetails}"/>

                <CollectionViewSource x:Key="ReferenceView" Source="{Binding ReferenceDetails}"/>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Project">
                <TreeView ItemsSource="{Binding Nodes}"
                          BorderThickness="0"
                          Margin="4"
                          SelectedItemChanged="Tree_SelectedItemChanged">

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Title}" Margin="2"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding SelectedTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0 0 0 10"/>

                <ToggleButton Grid.Row="0"
                              Content="Symbol details"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Padding="10 4"
                              IsEnabled="{Binding SelectedRow.HasSymbolDetails,
                                                    FallbackValue=False,
                                                    TargetNullValue=False}"
                              IsChecked="{Binding DetailsOpen, Mode=TwoWay}"/>

                <DataGrid x:Name="RowsGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Source={StaticResource RowsView}}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          IsSynchronizedWithCurrentItem="False">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name / designation"
                                            Binding="{Binding Title}"
                                            SortMemberPath="Title"
                                            Width="2*"/>
                        
                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            SortMemberPath="Description"
                                            Width="3*" />

                        <DataGridTextColumn Header="ID"
                                        Binding="{Binding EntityId}"
                                        SortMemberPath="EntityId"
                                        Width="260" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Width="260">

                    <TextBlock Text="Visible rows: "/>
                    <TextBlock Text="{Binding Items.Count, ElementName=RowsGrid}"/>

                    <TextBlock Text=" / Loaded rows: "
                               Margin="8,0,0,0" />
                    <TextBlock Text="{Binding RowCount}" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="2"
                    Panel.ZIndex="10"
                    Width="330"
                    HorizontalAlignment="Right"
                    Margin="0 40 0 0"
                    Padding="12"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetailsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0 0 0 12">
                        <ToggleButton DockPanel.Dock="Right"
                                      Content="Close"
                                      Padding="8 3"
                                      IsChecked="{Binding DetailsOpen, Mode=TwoWay}"/>

                        <TextBlock Text="{Binding SelectedRow.Title}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="CAD symbol" FontWeight="SemiBold"/>

                                <ComboBox Margin="0 6 0 12"
                                          ItemsSource="{Binding Source={StaticResource SymbolsView}}"
                                          DisplayMemberPath="Caption"
                                          IsSynchronizedWithCurrentItem="False"
                                          SelectedItem="{Binding SelectedSymbol, Mode=TwoWay}"/>

                            <TextBlock Text="No active CAD symbols in this selection."
                                           TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Symbols.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding DetailError}"
                                           Foreground="Firebrick"
                                           TextWrapping="Wrap"/>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSymbol}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Terminals"
                                           FontWeight="SemiBold"
                                           Margin="0 12 0 6"/>

                                <ItemsControl ItemsSource="{Binding Source={StaticResource TerminalsView}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       Margin="0 3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="References"
                                           FontWeight="SemiBold"
                                           Margin="0 16 0 6"/>

                                <ItemsControl ItemsSource="{Binding Source={StaticResource ReferenceView}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       Margin="0 3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    
                </DockPanel>
            </Border>
            
        </Grid>
    </Border>
</Window>
